{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExamPanel",
  "version": "0.1.0",
  "identifier": "vn.exampanel.app",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ExamPanel",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Phân công ra đề và phản biện đề kiểm tra",
    "longDescription": "Phần mềm tự động hóa phân công ban ra đề và phản biện đề kiểm tra cho trường THPT",
    "copyright": "Copyright 2026 ExamPanel Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
